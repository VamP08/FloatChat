# Copy to .env and fill in. Nothing here is required to run the map and charts against
# the committed demo database; only the chat needs a key.

# Where the data lives. Unset means the committed SQLite file under data/.
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# Google AI Studio key, for the natural-language chat. https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Comma-separated origins allowed to call this API.
# CORS_ORIGINS=http://localhost:5173

# Chat rate limit, per client address.
# CHAT_RATE_LIMIT=20
# CHAT_RATE_WINDOW=300

# Set to 1 to log every SQL statement.
# SQL_ECHO=0
